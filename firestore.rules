rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// Existing collections retain their current schemas and validators below:
// users, settings, customers, invoices, payments, giftHistory, giftItems,
// offers, monthlyCustomerStats, loyaltyLedger, rewardItems,
// redemptionRequests, overduePcRequests, and bonusPcRequests.
//
// customerCreditProfiles/{customerId}: admin-only calculated credit data.
// Includes customer identity, tier, credit days, monetary calculation fields,
// factors, history counts, approval state, hold state, optional override map,
// and ISO-string review timestamps. Clients never write these documents.
//
// customerCreditSummaries/{customerId}: customer-safe summary containing only
// customerId (string), availableCredit/usedCredit/creditDays (numbers),
// optional next due date/amount, creditStatus (enum), and updatedAt (string).
// Clients never write these documents.
//
// creditAuditLogs/{logId}: immutable admin audit entry containing customerId,
// customerName, action, adminUid, timestamp, oldValue, newValue, and reason.
// Clients never write these documents.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userProfilePath());
    }

    function profile() {
      return get(userProfilePath()).data;
    }

    function isActive() {
      return hasProfile() && profile().active == true;
    }

    function isAdmin() {
      return isActive() && profile().role == 'Admin';
    }

    function isStaff() {
      return isActive() && profile().role == 'Staff';
    }

    function isTeam() {
      return isAdmin() || isStaff();
    }

    function isCustomer() {
      return isActive() && profile().role in ['customer', 'Medical'];
    }

    function customerId() {
      return profile().customerId;
    }

    function ownsCustomerId(data) {
      return ('customerId' in profile()) && data.customerId == profile().customerId;
    }

    function ownsCustomerName(data) {
      return ('customerName' in profile())
        && (
          (('customerName' in data) && data.customerName == profile().customerName)
          || (('name' in data) && data.name == profile().customerName)
        );
    }

    function ownsCustomerRecord(data) {
      return isCustomer() && (ownsCustomerId(data) || ownsCustomerName(data));
    }

    function isPartnerLevel(level) {
      return level in ['Active Partner', 'Silver Partner', 'Gold Partner', 'Platinum Partner'];
    }

    function isCustomerTier(tier) {
      return tier in ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4'];
    }

    function isRedemptionStatus(status) {
      return status in ['Pending', 'Approved', 'Rejected', 'Gifted'];
    }

    function validOptionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    function validMonthlyCustomerStats(data) {
      return data.keys().hasOnly([
          'id',
          'customerId',
          'month',
          'totalSales',
          'totalProfit',
          'totalPayments',
          'orderCount',
          'overdueAmount',
          'target',
          'basePcEarned',
          'bonusPcEarned',
          'availablePc',
          'salesTarget',
          'profitTarget',
          'frequencyTarget',
          'paymentScore',
          'profitScore',
          'frequencyScore',
          'salesScore',
          'loyaltyScore',
          'rollingScore',
          'calculatedTier',
          'finalTier',
          'tierCapReason',
          'isOnboarding',
          'onboardingStage',
          'confidenceFactor',
          'pointsEarned',
          'currentLevel',
          'progressPercent',
          'updatedAt'
        ])
        && data.id is string
        && data.customerId is string
        && data.month is string
        && data.month.matches('^\\d{4}-\\d{2}$')
        && data.totalSales is number
        && (!('totalProfit' in data) || data.totalProfit is number)
        && data.totalPayments is number
        && data.orderCount is number
        && data.overdueAmount is number
        && data.target is number
        && (!('basePcEarned' in data) || data.basePcEarned is number)
        && (!('bonusPcEarned' in data) || data.bonusPcEarned is number)
        && (!('availablePc' in data) || data.availablePc is number)
        && (!('salesTarget' in data) || data.salesTarget is number)
        && (!('profitTarget' in data) || data.profitTarget is number)
        && (!('frequencyTarget' in data) || data.frequencyTarget is number)
        && (!('paymentScore' in data) || data.paymentScore is number)
        && (!('profitScore' in data) || data.profitScore is number)
        && (!('frequencyScore' in data) || data.frequencyScore is number)
        && (!('salesScore' in data) || data.salesScore is number)
        && (!('loyaltyScore' in data) || data.loyaltyScore is number)
        && (!('rollingScore' in data) || data.rollingScore is number)
        && (!('calculatedTier' in data) || isCustomerTier(data.calculatedTier))
        && (!('finalTier' in data) || isCustomerTier(data.finalTier))
        && validOptionalString(data, 'tierCapReason', 240)
        && (!('isOnboarding' in data) || data.isOnboarding is bool)
        && (!('onboardingStage' in data) || data.onboardingStage in ['None', 'Stage A', 'Stage B', 'Stage C', 'Stage D'])
        && (!('confidenceFactor' in data) || data.confidenceFactor is number)
        && data.pointsEarned is number
        && data.progressPercent is number
        && data.totalSales >= 0
        && data.totalPayments >= 0
        && data.orderCount >= 0
        && data.overdueAmount >= 0
        && data.target >= 0
        && (!('basePcEarned' in data) || data.basePcEarned >= 0)
        && (!('bonusPcEarned' in data) || data.bonusPcEarned >= 0)
        && (!('availablePc' in data) || data.availablePc >= 0)
        && (!('salesTarget' in data) || data.salesTarget >= 0)
        && (!('profitTarget' in data) || data.profitTarget >= 0)
        && (!('frequencyTarget' in data) || data.frequencyTarget >= 0)
        && (!('paymentScore' in data) || (data.paymentScore >= 0 && data.paymentScore <= 100))
        && (!('profitScore' in data) || (data.profitScore >= 0 && data.profitScore <= 100))
        && (!('frequencyScore' in data) || (data.frequencyScore >= 0 && data.frequencyScore <= 100))
        && (!('salesScore' in data) || (data.salesScore >= 0 && data.salesScore <= 100))
        && (!('loyaltyScore' in data) || (data.loyaltyScore >= 0 && data.loyaltyScore <= 100))
        && (!('rollingScore' in data) || (data.rollingScore >= 0 && data.rollingScore <= 100))
        && (!('confidenceFactor' in data) || (data.confidenceFactor >= 0 && data.confidenceFactor <= 1))
        && data.pointsEarned >= 0
        && data.progressPercent >= 0
        && data.progressPercent <= 100
        && isPartnerLevel(data.currentLevel)
        && data.updatedAt is string;
    }

    function validLoyaltyLedgerEntry(data) {
      return data.keys().hasOnly([
          'customerId',
          'type',
          'points',
          'reason',
          'referenceId',
          'month',
          'createdAt'
        ])
        && data.customerId is string
        && data.type in ['purchase', 'on_time_payment', 'monthly_target', 'order_frequency', 'overdue_payment', 'bonus', 'redemption', 'opening_balance', 'manual_adjustment', 'redemption_reversal']
        && data.points is number
        && ((data.type == 'manual_adjustment' && data.points != 0)
          || (data.type == 'redemption' && data.points < 0)
          || (data.type == 'opening_balance' && data.points >= 0)
          || (!(data.type in ['manual_adjustment', 'redemption', 'opening_balance']) && data.points > 0))
        && data.reason is string
        && data.reason.size() <= 160
        && data.referenceId is string
        && data.referenceId.size() <= 160
        && data.month is string
        && data.month.matches('^\\d{4}-\\d{2}$')
        && data.createdAt is string;
    }

    function validPcBalance(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId',
          'availablePc',
          'incomingPc',
          'redeemedPc',
          'protectedAt',
          'updatedAt'
        ])
        && data.customerId == customerDocId
        && data.availablePc is number
        && data.availablePc >= 0
        && data.incomingPc is number
        && data.incomingPc >= 0
        && data.redeemedPc is number
        && data.redeemedPc >= 0
        && data.availablePc == data.incomingPc - data.redeemedPc
        && data.protectedAt is string
        && data.updatedAt is string;
    }

    function validRewardItem(data) {
      return data.keys().hasOnly([
          'name',
          'requiredPoints',
          'levelRequired',
          'isActive',
          'description',
          'imageUrl',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.requiredPoints is number
        && data.requiredPoints >= 0
        && isPartnerLevel(data.levelRequired)
        && data.isActive is bool
        && validOptionalString(data, 'description', 500)
        && validOptionalString(data, 'imageUrl', 1200)
        && validOptionalString(data, 'imagePath', 500)
        && validOptionalString(data, 'createdAt', 40)
        && validOptionalString(data, 'updatedAt', 40);
    }

    function validOffer(data) {
      return data.keys().hasOnly([
          'title',
          'description',
          'imageUrl',
          'imagePath',
          'levelRequired',
          'startDate',
          'endDate',
          'isActive',
          'createdAt',
          'createdBy',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && validOptionalString(data, 'description', 1000)
        && validOptionalString(data, 'imageUrl', 1200)
        && validOptionalString(data, 'imagePath', 500)
        && (!('levelRequired' in data) || isPartnerLevel(data.levelRequired))
        && data.startDate is string
        && data.endDate is string
        && data.isActive is bool
        && validOptionalString(data, 'createdAt', 40)
        && validOptionalString(data, 'createdBy', 160)
        && validOptionalString(data, 'updatedAt', 40);
    }

    function validRedemptionRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'rewardId',
          'rewardName',
          'points',
          'status',
          'requestedAt',
          'reviewedAt',
          'reviewedBy',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.rewardId is string
        && data.rewardName is string
        && data.rewardName.size() <= 120
        && data.points is number
        && data.points >= 0
        && isRedemptionStatus(data.status)
        && data.requestedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'notes', 500);
    }

    function validOverduePcRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'invoiceId',
          'invoiceNumber',
          'invoiceDate',
          'dueDate',
          'fullPaymentDate',
          'overdueDays',
          'invoiceAmount',
          'suggestedCoins',
          'approvedCoins',
          'status',
          'generatedAt',
          'reviewedAt',
          'reviewedBy',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.invoiceId is string
        && data.invoiceNumber is string
        && data.invoiceNumber.size() <= 80
        && data.invoiceDate is string
        && data.dueDate is string
        && data.fullPaymentDate is string
        && data.overdueDays is number
        && data.overdueDays >= 0
        && data.invoiceAmount is number
        && data.invoiceAmount >= 0
        && data.suggestedCoins is number
        && data.suggestedCoins >= 0
        && data.approvedCoins is number
        && data.approvedCoins >= 0
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.generatedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'notes', 500);
    }

    function isBonusPcType(type) {
      return type in ['new_customer', 'payment', 'purchase_target', 'referral'];
    }

    function validBonusPcRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'bonusType',
          'bonusLabel',
          'triggerType',
          'referenceId',
          'suggestedCoins',
          'approvedCoins',
          'status',
          'generatedAt',
          'reviewedAt',
          'reviewedBy',
          'customerSeenAt',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && isBonusPcType(data.bonusType)
        && data.bonusLabel is string
        && data.bonusLabel.size() <= 80
        && data.triggerType is string
        && data.triggerType.size() <= 80
        && data.referenceId is string
        && data.referenceId.size() <= 160
        && data.suggestedCoins is number
        && data.suggestedCoins >= 0
        && data.approvedCoins is number
        && data.approvedCoins >= 0
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.generatedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'customerSeenAt', 40)
        && validOptionalString(data, 'notes', 500);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'role',
          'customerId',
          'customerName',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 160
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 140
        && data.role in ['Admin', 'Staff', 'customer', 'Medical']
        && data.active is bool
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && validOptionalString(data, 'customerId', 160)
        && validOptionalString(data, 'customerName', 140);
    }

    function validCreditOverride(data) {
      return data is map
        && data.keys().hasOnly(['amount', 'reason', 'expiresAt', 'createdAt', 'createdBy'])
        && data.amount is number
        && data.amount >= 0
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 500
        && data.expiresAt is string
        && data.expiresAt.size() == 10
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 160;
    }

    function validCreditProfile(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'tier',
          'creditDays',
          'currentOutstanding',
          'confirmedUninvoicedCreditOrders',
          'creditHistoryDays',
          'totalCreditInvoiceAmountInLookback',
          'totalCreditInvoiceAmountLast90Days',
          'averageMonthlyCreditSales',
          'baseCreditLimit',
          'calculatedCreditLimit',
          'approvedCreditLimit',
          'availableCredit',
          'paymentFactor',
          'historyFactor',
          'onTimePaymentPercentage',
          'completedCreditInvoices',
          'overdueAmount',
          'hasOverdueBeyondGrace',
          'creditStatus',
          'creditLimitApprovalStatus',
          'nextInvoiceDueDate',
          'nextInvoiceDueAmount',
          'lastCreditReviewAt',
          'lastCreditReviewReason',
          'manualHold',
          'manualStarterLimit',
          'creditOverride',
          'updatedAt'
        ])
        && data.customerId == customerDocId
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 140
        && data.tier in ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4']
        && data.creditDays is int
        && data.creditDays >= 0
        && data.creditHistoryDays in [60, 90]
        && data.currentOutstanding is number
        && data.currentOutstanding >= 0
        && data.confirmedUninvoicedCreditOrders is number
        && data.confirmedUninvoicedCreditOrders >= 0
        && data.totalCreditInvoiceAmountInLookback is number
        && data.totalCreditInvoiceAmountInLookback >= 0
        && data.totalCreditInvoiceAmountLast90Days is number
        && data.totalCreditInvoiceAmountLast90Days >= 0
        && data.averageMonthlyCreditSales is number
        && data.averageMonthlyCreditSales >= 0
        && data.baseCreditLimit is number
        && data.baseCreditLimit >= 0
        && data.calculatedCreditLimit is number
        && data.calculatedCreditLimit >= 0
        && data.approvedCreditLimit is number
        && data.approvedCreditLimit >= 0
        && data.availableCredit is number
        && data.availableCredit >= 0
        && data.paymentFactor is number
        && data.paymentFactor >= 0
        && data.historyFactor is number
        && data.historyFactor >= 0
        && data.onTimePaymentPercentage is number
        && data.onTimePaymentPercentage >= 0
        && data.onTimePaymentPercentage <= 100
        && data.completedCreditInvoices is int
        && data.completedCreditInvoices >= 0
        && data.overdueAmount is number
        && data.overdueAmount >= 0
        && data.hasOverdueBeyondGrace is bool
        && data.creditStatus in ['starter', 'active', 'hold', 'disabled']
        && data.creditLimitApprovalStatus in ['pending_starter', 'pending_calculated', 'approved', 'rejected']
        && (data.nextInvoiceDueDate == null || (data.nextInvoiceDueDate is string && data.nextInvoiceDueDate.size() == 10))
        && (data.nextInvoiceDueAmount == null || (data.nextInvoiceDueAmount is number && data.nextInvoiceDueAmount >= 0))
        && data.lastCreditReviewAt is string
        && data.lastCreditReviewAt.size() <= 40
        && data.lastCreditReviewReason is string
        && data.lastCreditReviewReason.size() > 0
        && data.lastCreditReviewReason.size() <= 500
        && data.manualHold is bool
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && (!('manualStarterLimit' in data) || (data.manualStarterLimit is number && data.manualStarterLimit >= 0))
        && (!('creditOverride' in data) || validCreditOverride(data.creditOverride));
    }

    function validCreditSummary(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId',
          'approvedCreditLimit',
          'availableCredit',
          'usedCredit',
          'creditDays',
          'nextInvoiceDueDate',
          'nextInvoiceDueAmount',
          'creditStatus',
          'manualHold',
          'updatedAt'
        ])
        && data.customerId == customerDocId
        && (!('approvedCreditLimit' in data) || (data.approvedCreditLimit is number && data.approvedCreditLimit >= 0))
        && data.availableCredit is number
        && data.availableCredit >= 0
        && data.usedCredit is number
        && data.usedCredit >= 0
        && data.creditDays is int
        && data.creditDays >= 0
        && (data.nextInvoiceDueDate == null || (data.nextInvoiceDueDate is string && data.nextInvoiceDueDate.size() == 10))
        && (data.nextInvoiceDueAmount == null || (data.nextInvoiceDueAmount is number && data.nextInvoiceDueAmount >= 0))
        && data.creditStatus in ['starter', 'active', 'hold', 'disabled']
        && (!('manualHold' in data) || data.manualHold is bool)
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validCreditAudit(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'action',
          'adminUid',
          'timestamp',
          'oldValue',
          'newValue',
          'reason'
        ])
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 160
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.action in ['approve', 'reject', 'manual_starter', 'hold', 'remove_hold', 'override', 'remove_override']
        && data.adminUid == request.auth.uid
        && data.timestamp is string
        && data.timestamp.size() <= 40
        && (data.oldValue == null || (data.oldValue is map && data.oldValue.keys().size() <= 10))
        && (data.newValue == null || (data.newValue is map && data.newValue.keys().size() <= 10))
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 500;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.uid == request.auth.uid
            || resource.data.email == request.auth.token.email
          )
        );

      allow create: if isAdmin()
        && validUserProfile(request.resource.data);

      allow update: if isAdmin()
        && validUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      // Authentication and profile deletion must stay synchronized through
      // the Admin-only deleteManagedUser Cloud Function.
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /customers/{customerDocId} {
      allow read: if isTeam() || (isCustomer() && customerDocId == customerId()) || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /customerCreditProfiles/{customerDocId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validCreditProfile(request.resource.data, customerDocId);
      allow delete: if isAdmin();
    }

    match /customerCreditSummaries/{customerDocId} {
      allow get: if isTeam() || (isCustomer() && customerDocId == customerId());
      allow list: if isTeam();
      allow create, update: if isAdmin() && validCreditSummary(request.resource.data, customerDocId);
      allow delete: if isAdmin();
    }

    match /creditAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCreditAudit(request.resource.data);
      allow update, delete: if false;
    }

    match /giftHistory/{giftId} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /giftItems/{giftItemId} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isTeam() || (isCustomer() && resource.data.isActive == true);
      allow create, update: if isAdmin() && validOffer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /monthlyCustomerStats/{statsId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isAdmin() && validMonthlyCustomerStats(request.resource.data);
      allow delete: if isAdmin();
    }

    match /loyaltyLedger/{entryId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if isAdmin() && validLoyaltyLedgerEntry(request.resource.data);
      allow update, delete: if false;
    }

    match /pcBalances/{customerDocId} {
      allow read: if isTeam() || (isCustomer() && customerId() == customerDocId);
      allow create, update: if isAdmin() && validPcBalance(request.resource.data, customerDocId);
      allow delete: if false;
    }

    match /rewardItems/{rewardId} {
      allow read: if isTeam() || (isCustomer() && resource.data.isActive == true);
      allow create, update: if isAdmin() && validRewardItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /redemptionRequests/{requestId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if isCustomer()
        && validRedemptionRequest(request.resource.data)
        && ownsCustomerRecord(request.resource.data)
        && request.resource.data.status == 'Pending';
      allow update: if isCustomer()
        && ownsCustomerRecord(resource.data)
        && ownsCustomerRecord(request.resource.data)
        && validRedemptionRequest(request.resource.data)
        && resource.data.status == 'Rejected'
        && request.resource.data.status == 'Pending'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.rewardId == resource.data.rewardId
        && request.resource.data.rewardName == resource.data.rewardName
        && request.resource.data.points == resource.data.points;
      allow update: if isAdmin() && validRedemptionRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /overduePcRequests/{requestId} {
      allow read: if isTeam() || (isCustomer() && ownsCustomerRecord(resource.data) && resource.data.status == 'Approved');
      allow create, update: if isAdmin() && validOverduePcRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bonusPcRequests/{requestId} {
      allow read: if isTeam() || (isCustomer() && ownsCustomerRecord(resource.data) && resource.data.status == 'Approved');
      allow create, update: if isAdmin() && validBonusPcRequest(request.resource.data);
      allow update: if isCustomer()
        && ownsCustomerRecord(resource.data)
        && ownsCustomerRecord(request.resource.data)
        && resource.data.status == 'Approved'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['customerSeenAt'])
        && request.resource.data.customerSeenAt is string
        && request.resource.data.customerSeenAt.size() <= 40;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
