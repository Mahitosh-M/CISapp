rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userProfilePath());
    }

    function profile() {
      return get(userProfilePath()).data;
    }

    function isActive() {
      return hasProfile() && profile().active == true;
    }

    function isAdmin() {
      return isActive() && profile().role == 'Admin';
    }

    function isStaff() {
      return isActive() && profile().role == 'Staff';
    }

    function isTeam() {
      return isAdmin() || isStaff();
    }

    function isCustomer() {
      return isActive() && profile().role == 'customer';
    }

    function customerId() {
      return profile().customerId;
    }

    function ownsCustomerId(data) {
      return ('customerId' in profile()) && data.customerId == profile().customerId;
    }

    function ownsCustomerName(data) {
      return ('customerName' in profile())
        && (
          (('customerName' in data) && data.customerName == profile().customerName)
          || (('name' in data) && data.name == profile().customerName)
        );
    }

    function ownsCustomerRecord(data) {
      return isCustomer() && (ownsCustomerId(data) || ownsCustomerName(data));
    }

    function isPartnerLevel(level) {
      return level in ['Active Partner', 'Silver Partner', 'Gold Partner', 'Platinum Partner'];
    }

    function isCustomerTier(tier) {
      return tier in ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4'];
    }

    function isRedemptionStatus(status) {
      return status in ['Pending', 'Approved', 'Rejected', 'Gifted'];
    }

    function validOptionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    function validMonthlyCustomerStats(data) {
      return data.keys().hasOnly([
          'id',
          'customerId',
          'month',
          'totalSales',
          'totalProfit',
          'totalPayments',
          'orderCount',
          'overdueAmount',
          'target',
          'basePcEarned',
          'bonusPcEarned',
          'availablePc',
          'salesTarget',
          'profitTarget',
          'frequencyTarget',
          'paymentScore',
          'profitScore',
          'frequencyScore',
          'salesScore',
          'loyaltyScore',
          'rollingScore',
          'calculatedTier',
          'finalTier',
          'tierCapReason',
          'isOnboarding',
          'onboardingStage',
          'confidenceFactor',
          'pointsEarned',
          'currentLevel',
          'progressPercent',
          'updatedAt'
        ])
        && data.id is string
        && data.customerId is string
        && data.month is string
        && data.month.matches('^\\d{4}-\\d{2}$')
        && data.totalSales is number
        && (!('totalProfit' in data) || data.totalProfit is number)
        && data.totalPayments is number
        && data.orderCount is number
        && data.overdueAmount is number
        && data.target is number
        && (!('basePcEarned' in data) || data.basePcEarned is number)
        && (!('bonusPcEarned' in data) || data.bonusPcEarned is number)
        && (!('availablePc' in data) || data.availablePc is number)
        && (!('salesTarget' in data) || data.salesTarget is number)
        && (!('profitTarget' in data) || data.profitTarget is number)
        && (!('frequencyTarget' in data) || data.frequencyTarget is number)
        && (!('paymentScore' in data) || data.paymentScore is number)
        && (!('profitScore' in data) || data.profitScore is number)
        && (!('frequencyScore' in data) || data.frequencyScore is number)
        && (!('salesScore' in data) || data.salesScore is number)
        && (!('loyaltyScore' in data) || data.loyaltyScore is number)
        && (!('rollingScore' in data) || data.rollingScore is number)
        && (!('calculatedTier' in data) || isCustomerTier(data.calculatedTier))
        && (!('finalTier' in data) || isCustomerTier(data.finalTier))
        && validOptionalString(data, 'tierCapReason', 240)
        && (!('isOnboarding' in data) || data.isOnboarding is bool)
        && (!('onboardingStage' in data) || data.onboardingStage in ['None', 'Stage A', 'Stage B', 'Stage C', 'Stage D'])
        && (!('confidenceFactor' in data) || data.confidenceFactor is number)
        && data.pointsEarned is number
        && data.progressPercent is number
        && data.totalSales >= 0
        && data.totalPayments >= 0
        && data.orderCount >= 0
        && data.overdueAmount >= 0
        && data.target >= 0
        && (!('basePcEarned' in data) || data.basePcEarned >= 0)
        && (!('bonusPcEarned' in data) || data.bonusPcEarned >= 0)
        && (!('availablePc' in data) || data.availablePc >= 0)
        && (!('salesTarget' in data) || data.salesTarget >= 0)
        && (!('profitTarget' in data) || data.profitTarget >= 0)
        && (!('frequencyTarget' in data) || data.frequencyTarget >= 0)
        && (!('paymentScore' in data) || (data.paymentScore >= 0 && data.paymentScore <= 100))
        && (!('profitScore' in data) || (data.profitScore >= 0 && data.profitScore <= 100))
        && (!('frequencyScore' in data) || (data.frequencyScore >= 0 && data.frequencyScore <= 100))
        && (!('salesScore' in data) || (data.salesScore >= 0 && data.salesScore <= 100))
        && (!('loyaltyScore' in data) || (data.loyaltyScore >= 0 && data.loyaltyScore <= 100))
        && (!('rollingScore' in data) || (data.rollingScore >= 0 && data.rollingScore <= 100))
        && (!('confidenceFactor' in data) || (data.confidenceFactor >= 0 && data.confidenceFactor <= 1))
        && data.pointsEarned >= 0
        && data.progressPercent >= 0
        && data.progressPercent <= 100
        && isPartnerLevel(data.currentLevel)
        && data.updatedAt is string;
    }

    function validLoyaltyLedgerEntry(data) {
      return data.keys().hasOnly([
          'customerId',
          'type',
          'points',
          'reason',
          'referenceId',
          'month',
          'createdAt'
        ])
        && data.customerId is string
        && data.type in ['purchase', 'on_time_payment', 'monthly_target', 'order_frequency', 'overdue_payment', 'bonus', 'redemption']
        && data.points is number
        && data.reason is string
        && data.reason.size() <= 160
        && data.referenceId is string
        && data.referenceId.size() <= 160
        && data.month is string
        && data.month.matches('^\\d{4}-\\d{2}$')
        && data.createdAt is string;
    }

    function validRewardItem(data) {
      return data.keys().hasOnly([
          'name',
          'requiredPoints',
          'levelRequired',
          'isActive',
          'description',
          'imageUrl',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.requiredPoints is number
        && data.requiredPoints >= 0
        && isPartnerLevel(data.levelRequired)
        && data.isActive is bool
        && validOptionalString(data, 'description', 500)
        && validOptionalString(data, 'imageUrl', 1200)
        && validOptionalString(data, 'imagePath', 500)
        && validOptionalString(data, 'createdAt', 40)
        && validOptionalString(data, 'updatedAt', 40);
    }

    function validOffer(data) {
      return data.keys().hasOnly([
          'title',
          'description',
          'imageUrl',
          'imagePath',
          'levelRequired',
          'startDate',
          'endDate',
          'isActive',
          'createdAt',
          'createdBy',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && validOptionalString(data, 'description', 1000)
        && validOptionalString(data, 'imageUrl', 1200)
        && validOptionalString(data, 'imagePath', 500)
        && (!('levelRequired' in data) || isPartnerLevel(data.levelRequired))
        && data.startDate is string
        && data.endDate is string
        && data.isActive is bool
        && validOptionalString(data, 'createdAt', 40)
        && validOptionalString(data, 'createdBy', 160)
        && validOptionalString(data, 'updatedAt', 40);
    }

    function validRedemptionRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'rewardId',
          'rewardName',
          'points',
          'status',
          'requestedAt',
          'reviewedAt',
          'reviewedBy',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.rewardId is string
        && data.rewardName is string
        && data.rewardName.size() <= 120
        && data.points is number
        && data.points >= 0
        && isRedemptionStatus(data.status)
        && data.requestedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'notes', 500);
    }

    function validOverduePcRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'invoiceId',
          'invoiceNumber',
          'invoiceDate',
          'dueDate',
          'fullPaymentDate',
          'overdueDays',
          'invoiceAmount',
          'suggestedCoins',
          'approvedCoins',
          'status',
          'generatedAt',
          'reviewedAt',
          'reviewedBy',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.invoiceId is string
        && data.invoiceNumber is string
        && data.invoiceNumber.size() <= 80
        && data.invoiceDate is string
        && data.dueDate is string
        && data.fullPaymentDate is string
        && data.overdueDays is number
        && data.overdueDays >= 0
        && data.invoiceAmount is number
        && data.invoiceAmount >= 0
        && data.suggestedCoins is number
        && data.suggestedCoins >= 0
        && data.approvedCoins is number
        && data.approvedCoins >= 0
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.generatedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'notes', 500);
    }

    function isBonusPcType(type) {
      return type in ['new_customer', 'payment', 'purchase_target', 'referral'];
    }

    function validBonusPcRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'bonusType',
          'bonusLabel',
          'triggerType',
          'referenceId',
          'suggestedCoins',
          'approvedCoins',
          'status',
          'generatedAt',
          'reviewedAt',
          'reviewedBy',
          'customerSeenAt',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && isBonusPcType(data.bonusType)
        && data.bonusLabel is string
        && data.bonusLabel.size() <= 80
        && data.triggerType is string
        && data.triggerType.size() <= 80
        && data.referenceId is string
        && data.referenceId.size() <= 160
        && data.suggestedCoins is number
        && data.suggestedCoins >= 0
        && data.approvedCoins is number
        && data.approvedCoins >= 0
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.generatedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'customerSeenAt', 40)
        && validOptionalString(data, 'notes', 500);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'role',
          'customerId',
          'customerName',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.email is string
        && data.name is string
        && data.role in ['Admin', 'Staff', 'customer']
        && data.active is bool
        && data.createdAt is string
        && data.updatedAt is string
        && (!('customerId' in data) || data.customerId is string)
        && (!('customerName' in data) || data.customerName is string);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.uid == request.auth.uid
            || resource.data.email == request.auth.token.email
          )
        );

      allow create: if signedIn()
        && validUserProfile(request.resource.data)
        && (
          isAdmin()
          || (
            request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'Admin'
            && request.resource.data.active == true
          )
        );

      allow update: if isAdmin()
        && validUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isAdmin() && request.auth.uid != resource.data.uid;
    }

    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /customers/{customerDocId} {
      allow read: if isTeam() || (isCustomer() && customerDocId == customerId()) || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /giftHistory/{giftId} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /giftItems/{giftItemId} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isTeam() || (isCustomer() && resource.data.isActive == true);
      allow create, update: if isAdmin() && validOffer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /monthlyCustomerStats/{statsId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isAdmin() && validMonthlyCustomerStats(request.resource.data);
      allow delete: if isAdmin();
    }

    match /loyaltyLedger/{entryId} {
      allow read: if isTeam();
      allow create, update: if isAdmin() && validLoyaltyLedgerEntry(request.resource.data);
      allow delete: if isAdmin();
    }

    match /rewardItems/{rewardId} {
      allow read: if isTeam() || (isCustomer() && resource.data.isActive == true);
      allow create, update: if isAdmin() && validRewardItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /redemptionRequests/{requestId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if isCustomer()
        && validRedemptionRequest(request.resource.data)
        && ownsCustomerRecord(request.resource.data)
        && request.resource.data.status == 'Pending';
      allow update: if isCustomer()
        && ownsCustomerRecord(resource.data)
        && ownsCustomerRecord(request.resource.data)
        && validRedemptionRequest(request.resource.data)
        && resource.data.status == 'Rejected'
        && request.resource.data.status == 'Pending'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.rewardId == resource.data.rewardId
        && request.resource.data.rewardName == resource.data.rewardName
        && request.resource.data.points == resource.data.points;
      allow update: if isAdmin() && validRedemptionRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /overduePcRequests/{requestId} {
      allow read: if isTeam() || (isCustomer() && ownsCustomerRecord(resource.data) && resource.data.status == 'Approved');
      allow create, update: if isAdmin() && validOverduePcRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bonusPcRequests/{requestId} {
      allow read: if isTeam() || (isCustomer() && ownsCustomerRecord(resource.data) && resource.data.status == 'Approved');
      allow create, update: if isAdmin() && validBonusPcRequest(request.resource.data);
      allow update: if isCustomer()
        && ownsCustomerRecord(resource.data)
        && ownsCustomerRecord(request.resource.data)
        && resource.data.status == 'Approved'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['customerSeenAt'])
        && request.resource.data.customerSeenAt is string
        && request.resource.data.customerSeenAt.size() <= 40;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
