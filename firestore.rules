rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// Existing collections retain their current schemas and validators below:
// users, settings, customers, invoices, payments, giftHistory, giftItems,
// offers, monthlyCustomerStats, loyaltyLedger, rewardItems,
// redemptionRequests, overduePcRequests, and bonusPcRequests.
//
// customerCreditProfiles/{customerId}: admin-only calculated credit data.
// Includes customer identity, tier, credit days, monetary calculation fields,
// factors, history counts, approval state, hold state, optional override map,
// and ISO-string review timestamps. Clients never write these documents.
//
// customerCreditSummaries/{customerId}: customer-safe summary containing only
// customerId (string), availableCredit/usedCredit/creditDays (numbers),
// optional next due date/amount, creditStatus (enum), and updatedAt (string).
// Clients never write these documents.
//
// creditAuditLogs/{logId}: immutable admin audit entry containing customerId,
// customerName, action, adminUid, timestamp, oldValue, newValue, and reason.
// Clients never write these documents.
//
// shopCash/{SHOP_A|SHOP_S}: shared branch summary. CRM payment writes update
// collections; Cash App batches update expenses/transfers through immutable
// audit records. Admin-only cashAdjustments/{adjustmentId} records manual
// additions/deductions. cashInitializations/{shopId} records opening cash.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userProfilePath());
    }

    function profile() {
      return get(userProfilePath()).data;
    }

    function isActive() {
      return hasProfile() && profile().active == true;
    }

    function isAdmin() {
      return isActive() && profile().role == 'Admin';
    }

    function isStaff() {
      return isActive() && profile().role == 'Staff';
    }

    function isTeam() {
      return isAdmin() || isStaff();
    }

    function isCustomer() {
      return isActive() && profile().role in ['customer', 'Medical'];
    }

    function customerId() {
      return profile().customerId;
    }

    function ownsCustomerId(data) {
      return ('customerId' in profile()) && data.customerId == profile().customerId;
    }

    function ownsCustomerName(data) {
      return ('customerName' in profile())
        && (
          (('customerName' in data) && data.customerName == profile().customerName)
          || (('name' in data) && data.name == profile().customerName)
        );
    }

    function ownsCustomerRecord(data) {
      return isCustomer() && (ownsCustomerId(data) || ownsCustomerName(data));
    }

    function validShopId(shopId) {
      return shopId in ['SHOP_A', 'SHOP_S'];
    }

    function hasAssignedShop() {
      return isStaff() && ('shopId' in profile()) && validShopId(profile().shopId);
    }

    function isBranchAware(data) {
      return ('branchSystemVersion' in data)
        && data.branchSystemVersion == 1
        && ('shopId' in data)
        && validShopId(data.shopId);
    }

    function hasNoBranchFields(data) {
      return !('branchSystemVersion' in data) && !('shopId' in data);
    }

    function validBranchEnvelope(data) {
      return hasNoBranchFields(data) || isBranchAware(data);
    }

    function validBranchCreateForActor(data) {
      return validBranchEnvelope(data)
        && (
          isAdmin()
          || (hasAssignedShop()
            ? isBranchAware(data) && data.shopId == profile().shopId
            : hasNoBranchFields(data))
        );
    }

    function validInvoiceBranchUpdateForActor() {
      return validBranchEnvelope(request.resource.data)
        && (
          (hasNoBranchFields(resource.data) && hasNoBranchFields(request.resource.data))
          || (isBranchAware(resource.data)
            && isBranchAware(request.resource.data)
            && request.resource.data.shopId == resource.data.shopId
            && (isAdmin() || !hasAssignedShop() || resource.data.shopId == profile().shopId))
        );
    }

    function validPaymentBranchUpdateForActor() {
      return validBranchEnvelope(request.resource.data)
        && (
          (hasNoBranchFields(resource.data) && hasNoBranchFields(request.resource.data))
          || (isBranchAware(resource.data)
            && isBranchAware(request.resource.data)
            && (
              isAdmin()
              || (hasAssignedShop()
                ? resource.data.shopId == profile().shopId
                  && request.resource.data.shopId == profile().shopId
                : request.resource.data.shopId == resource.data.shopId)
            ))
        );
    }

    function validPaymentCashFields(data) {
      return isBranchAware(data)
        ? ('affectsShopCash' in data)
          && data.affectsShopCash is bool
          && ('cashSyncedAmount' in data)
          && data.cashSyncedAmount is number
          && data.cashSyncedAmount >= 0
          && ('amount' in data)
          && data.amount is number
          && data.amount >= 0
          && ((('paymentKind' in data) && data.paymentKind == 'advance_application') || data.affectsShopCash == false
            ? data.cashSyncedAmount == 0
            : data.cashSyncedAmount == data.amount)
        : !('affectsShopCash' in data) && !('cashSyncedAmount' in data);
    }

    function validOptionalCashNumber(data, field) {
      return !(field in data)
        || (data[field] is number && data[field] >= 0 && data[field] <= 1000000000000);
    }

    function cashNumber(data, field) {
      return field in data ? data[field] : 0;
    }

    function validShopCash(data, shopId) {
      return data.keys().hasAll(['shopId', 'availableBalance', 'totalCollections', 'updatedAt'])
        && data.keys().hasOnly([
          'shopId',
          'availableBalance',
          'totalCollections',
          'totalExpenses',
          'totalTransferredIn',
          'totalTransferredOut',
          'openingBalance',
          'lastCashOperationId',
          'lastCashOperationType',
          'initializedAt',
          'initializedBy',
          'updatedAt'
        ])
        && data.shopId == shopId
        && validShopId(data.shopId)
        && data.availableBalance is number
        && data.availableBalance >= -1000000000000
        && data.availableBalance <= 1000000000000
        && data.totalCollections is number
        && data.totalCollections >= 0
        && data.totalCollections <= 1000000000000
        && validOptionalCashNumber(data, 'totalExpenses')
        && validOptionalCashNumber(data, 'totalTransferredIn')
        && validOptionalCashNumber(data, 'totalTransferredOut')
        && validOptionalCashNumber(data, 'openingBalance')
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40
        && (
          (!('lastCashOperationId' in data) && !('lastCashOperationType' in data))
          || (data.lastCashOperationId is string
            && data.lastCashOperationId.size() > 0
            && data.lastCashOperationId.size() <= 160
            && data.lastCashOperationType in [
              'payment', 'invoice_delete', 'expense', 'transfer', 'transfer_edit', 'adjustment', 'initialization'
            ])
        )
        && (
          (!('initializedAt' in data) && !('initializedBy' in data) && !('openingBalance' in data))
          || (data.initializedAt is timestamp
            && data.initializedBy is string
            && data.initializedBy.size() > 0
            && data.initializedBy.size() <= 160
            && 'openingBalance' in data)
        );
    }

    function isInitializedShopCash(data) {
      return 'initializedAt' in data
        && 'initializedBy' in data
        && 'openingBalance' in data
        && 'totalExpenses' in data
        && 'totalTransferredIn' in data
        && 'totalTransferredOut' in data;
    }

    function canWritePaymentShopCash(shopId) {
      return isAdmin()
        || (isStaff() && (!hasAssignedShop() || profile().shopId == shopId));
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    function paymentCashAmountForShop(data, shopId) {
      return isBranchAware(data)
          && data.shopId == shopId
          && ('cashSyncedAmount' in data)
          && data.cashSyncedAmount is number
        ? data.cashSyncedAmount
        : 0;
    }

    function paymentCashDelta(paymentId, shopId) {
      let path = paymentPath(paymentId);
      let beforeAmount = exists(path)
        ? paymentCashAmountForShop(get(path).data, shopId)
        : 0;
      let afterAmount = existsAfter(path)
        ? paymentCashAmountForShop(getAfter(path).data, shopId)
        : 0;
      return afterAmount - beforeAmount;
    }

    function paymentSummaryDeltaMatches(paymentId, shopId) {
      let path = cashSummaryPath(shopId);
      let delta = paymentCashDelta(paymentId, shopId);
      let afterSummary = getAfter(path);
      return delta == 0
        || (existsAfter(path)
          && afterSummary.data.lastCashOperationId == paymentId
          && afterSummary.data.lastCashOperationType == 'payment'
          && (exists(path)
            ? afterSummary.data.availableBalance - get(path).data.availableBalance == delta
              && afterSummary.data.totalCollections - get(path).data.totalCollections == delta
            : afterSummary.data.availableBalance == delta
              && afterSummary.data.totalCollections == delta));
    }

    function validPaymentCashMutation(paymentId) {
      return paymentSummaryDeltaMatches(paymentId, 'SHOP_A')
        && paymentSummaryDeltaMatches(paymentId, 'SHOP_S');
    }

    function validPaymentShopCashCreate(shopId) {
      let paymentId = request.resource.data.lastCashOperationId;
      let delta = paymentCashDelta(paymentId, shopId);
      return canWritePaymentShopCash(shopId)
        && request.resource.data.keys().hasOnly([
          'shopId',
          'availableBalance',
          'totalCollections',
          'lastCashOperationId',
          'lastCashOperationType',
          'updatedAt'
        ])
        && request.resource.data.lastCashOperationType == 'payment'
        && delta > 0
        && request.resource.data.availableBalance == delta
        && request.resource.data.totalCollections == delta;
    }

    function validPaymentShopCashUpdate(shopId) {
      let paymentId = request.resource.data.lastCashOperationId;
      let delta = paymentCashDelta(paymentId, shopId);
      return canWritePaymentShopCash(shopId)
        && request.resource.data.lastCashOperationType == 'payment'
        && delta != 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance',
          'totalCollections',
          'lastCashOperationId',
          'lastCashOperationType',
          'updatedAt'
        ])
        && request.resource.data.availableBalance - resource.data.availableBalance
          == delta
        && request.resource.data.totalCollections - resource.data.totalCollections
          == delta;
    }

    function hasInvoiceDeleteSummaryMarker(invoiceId, shopId, paymentAmount) {
      let summaryPath = cashSummaryPath(shopId);
      let summaryAfter = getAfter(summaryPath);
      return paymentAmount == 0
        || (exists(summaryPath)
          && existsAfter(summaryPath)
          && summaryAfter.data.lastCashOperationId == invoiceId
          && summaryAfter.data.lastCashOperationType == 'invoice_delete'
          && summaryAfter.data.availableBalance - get(summaryPath).data.availableBalance <= -paymentAmount
          && summaryAfter.data.totalCollections - get(summaryPath).data.totalCollections <= -paymentAmount);
    }

    function validInvoiceDeletePaymentCashMutation() {
      let shopAAmount = paymentCashAmountForShop(resource.data, 'SHOP_A');
      let shopSAmount = paymentCashAmountForShop(resource.data, 'SHOP_S');
      return (shopAAmount == 0 && shopSAmount == 0)
        || (isAdmin()
          && ('invoiceId' in resource.data)
          && resource.data.invoiceId is string
          && resource.data.invoiceId.size() > 0
          && exists(invoicePath(resource.data.invoiceId))
          && !existsAfter(invoicePath(resource.data.invoiceId))
          && hasInvoiceDeleteSummaryMarker(resource.data.invoiceId, 'SHOP_A', shopAAmount)
          && hasInvoiceDeleteSummaryMarker(resource.data.invoiceId, 'SHOP_S', shopSAmount));
    }

    function validInvoiceDeleteShopCashUpdate(shopId) {
      let invoiceId = request.resource.data.lastCashOperationId;
      let delta = request.resource.data.availableBalance - resource.data.availableBalance;
      return isAdmin()
        && request.resource.data.shopId == shopId
        && request.resource.data.lastCashOperationType == 'invoice_delete'
        && exists(invoicePath(invoiceId))
        && !existsAfter(invoicePath(invoiceId))
        && delta < 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance',
          'totalCollections',
          'lastCashOperationId',
          'lastCashOperationType',
          'updatedAt'
        ])
        && request.resource.data.totalCollections - resource.data.totalCollections == delta;
    }

    function cashSummaryPath(shopId) {
      return /databases/$(database)/documents/shopCash/$(shopId);
    }

    function cashExpensePath(expenseId) {
      return /databases/$(database)/documents/cashExpenses/$(expenseId);
    }

    function shopTransferPath(transferId) {
      return /databases/$(database)/documents/shopTransfers/$(transferId);
    }

    function cashAdjustmentPath(adjustmentId) {
      return /databases/$(database)/documents/cashAdjustments/$(adjustmentId);
    }

    function cashInitializationPath(shopId) {
      return /databases/$(database)/documents/cashInitializations/$(shopId);
    }

    function validCashActor(shopId) {
      return isAdmin() || (hasAssignedShop() && profile().shopId == shopId);
    }

    function validCashExpense(data, expenseId) {
      return data.keys().hasOnly(['shopId', 'amount', 'description', 'createdAt', 'createdBy'])
        && expenseId.size() > 0
        && expenseId.size() <= 160
        && validShopId(data.shopId)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 160
        && data.description.matches('.*[^ ].*')
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && data.createdBy.size() <= 160;
    }

    function validExpenseAuditCreate(expenseId) {
      let summaryPath = cashSummaryPath(request.resource.data.shopId);
      let summaryAfter = getAfter(summaryPath);
      return validCashExpense(request.resource.data, expenseId)
        && validCashActor(request.resource.data.shopId)
        && exists(summaryPath)
        && existsAfter(summaryPath)
        && summaryAfter.data.lastCashOperationId == expenseId
        && summaryAfter.data.lastCashOperationType == 'expense';
    }

    function validExpenseShopCashUpdate(shopId) {
      let expenseId = request.resource.data.lastCashOperationId;
      let expensePath = cashExpensePath(expenseId);
      let expenseAfter = getAfter(expensePath);
      return !exists(expensePath)
        && existsAfter(expensePath)
        && expenseAfter.data.shopId == shopId
        && isInitializedShopCash(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance',
          'totalExpenses',
          'lastCashOperationId',
          'lastCashOperationType',
          'updatedAt'
        ])
        && request.resource.data.availableBalance
          == resource.data.availableBalance - expenseAfter.data.amount
        && cashNumber(request.resource.data, 'totalExpenses')
          == cashNumber(resource.data, 'totalExpenses') + expenseAfter.data.amount;
    }

    function validShopTransfer(data, transferId) {
      return data.keys().hasOnly([
          'fromShopId', 'toShopId', 'amount', 'note', 'createdAt', 'createdBy'
        ])
        && transferId.size() > 0
        && transferId.size() <= 160
        && validShopId(data.fromShopId)
        && validShopId(data.toShopId)
        && data.fromShopId != data.toShopId
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && data.note is string
        && data.note.size() <= 160
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && data.createdBy.size() <= 160;
    }

    function validTransferAuditCreate(transferId) {
      let senderPath = cashSummaryPath(request.resource.data.fromShopId);
      let receiverPath = cashSummaryPath(request.resource.data.toShopId);
      let senderAfter = getAfter(senderPath);
      let receiverAfter = getAfter(receiverPath);
      return validShopTransfer(request.resource.data, transferId)
        && validCashActor(request.resource.data.fromShopId)
        && exists(senderPath)
        && exists(receiverPath)
        && existsAfter(senderPath)
        && existsAfter(receiverPath)
        && senderAfter.data.lastCashOperationId == transferId
        && senderAfter.data.lastCashOperationType == 'transfer'
        && receiverAfter.data.lastCashOperationId == transferId
        && receiverAfter.data.lastCashOperationType == 'transfer';
    }

    function transferEditSummaryMatches(transferId, shopId, balanceDelta, totalField, totalDelta) {
      let summaryPath = cashSummaryPath(shopId);
      let summaryAfter = getAfter(summaryPath);
      return exists(summaryPath)
        && existsAfter(summaryPath)
        && summaryAfter.data.lastCashOperationId == transferId
        && summaryAfter.data.lastCashOperationType == 'transfer_edit'
        && summaryAfter.data.availableBalance - get(summaryPath).data.availableBalance == balanceDelta
        && cashNumber(summaryAfter.data, totalField)
          - cashNumber(get(summaryPath).data, totalField) == totalDelta;
    }

    function validShopTransferUpdate(transferId) {
      return validCashActor(resource.data.fromShopId)
        && transferId.size() > 0
        && transferId.size() <= 160
        && request.resource.data.keys().hasAll([
          'fromShopId', 'toShopId', 'amount', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'fromShopId', 'toShopId', 'amount', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.fromShopId == resource.data.fromShopId
        && request.resource.data.toShopId == resource.data.toShopId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedBy.size() <= 160
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount', 'note', 'updatedAt', 'updatedBy'
        ])
        && (
          request.resource.data.amount != resource.data.amount
          || request.resource.data.note != resource.data.note
        );
    }

    function validTransferAuditUpdate(transferId) {
      let amountDelta = request.resource.data.amount - resource.data.amount;
      let senderPath = cashSummaryPath(resource.data.fromShopId);
      return validShopTransferUpdate(transferId)
        && (
          amountDelta == 0
          || (transferEditSummaryMatches(
                transferId,
                resource.data.fromShopId,
                -amountDelta,
                'totalTransferredOut',
                amountDelta
              )
            && transferEditSummaryMatches(
                transferId,
                resource.data.toShopId,
                amountDelta,
                'totalTransferredIn',
                amountDelta
              )
            && (amountDelta < 0 || getAfter(senderPath).data.availableBalance >= 0))
        );
    }

    function validTransferShopCashUpdate(shopId) {
      let transferId = request.resource.data.lastCashOperationId;
      let transferPath = shopTransferPath(transferId);
      let transferAfter = getAfter(transferPath);
      return !exists(transferPath)
        && existsAfter(transferPath)
        && isInitializedShopCash(resource.data)
        && (
          (shopId == transferAfter.data.fromShopId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'availableBalance',
              'totalTransferredOut',
              'lastCashOperationId',
              'lastCashOperationType',
              'updatedAt'
            ])
            && request.resource.data.availableBalance >= 0
            && request.resource.data.availableBalance
              == resource.data.availableBalance - transferAfter.data.amount
            && cashNumber(request.resource.data, 'totalTransferredOut')
              == cashNumber(resource.data, 'totalTransferredOut') + transferAfter.data.amount)
          || (shopId == transferAfter.data.toShopId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'availableBalance',
              'totalTransferredIn',
              'lastCashOperationId',
              'lastCashOperationType',
              'updatedAt'
            ])
            && request.resource.data.availableBalance
              == resource.data.availableBalance + transferAfter.data.amount
            && cashNumber(request.resource.data, 'totalTransferredIn')
              == cashNumber(resource.data, 'totalTransferredIn') + transferAfter.data.amount)
        );
    }

    function validTransferEditShopCashUpdate(shopId) {
      let transferId = request.resource.data.lastCashOperationId;
      let transferPath = shopTransferPath(transferId);
      let transferBefore = get(transferPath);
      let transferAfter = getAfter(transferPath);
      let amountDelta = transferAfter.data.amount - transferBefore.data.amount;
      return exists(transferPath)
        && existsAfter(transferPath)
        && validCashActor(transferBefore.data.fromShopId)
        && transferAfter.data.fromShopId == transferBefore.data.fromShopId
        && transferAfter.data.toShopId == transferBefore.data.toShopId
        && amountDelta != 0
        && isInitializedShopCash(resource.data)
        && (
          (shopId == transferBefore.data.fromShopId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'availableBalance',
              'totalTransferredOut',
              'lastCashOperationId',
              'lastCashOperationType',
              'updatedAt'
            ])
            && request.resource.data.availableBalance - resource.data.availableBalance == -amountDelta
            && cashNumber(request.resource.data, 'totalTransferredOut')
              - cashNumber(resource.data, 'totalTransferredOut') == amountDelta
            && (amountDelta < 0 || request.resource.data.availableBalance >= 0))
          || (shopId == transferBefore.data.toShopId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'availableBalance',
              'totalTransferredIn',
              'lastCashOperationId',
              'lastCashOperationType',
              'updatedAt'
            ])
            && request.resource.data.availableBalance - resource.data.availableBalance == amountDelta
            && cashNumber(request.resource.data, 'totalTransferredIn')
              - cashNumber(resource.data, 'totalTransferredIn') == amountDelta)
        );
    }

    function validCashAdjustment(data, adjustmentId) {
      return data.keys().hasOnly([
          'shopId', 'amount', 'direction', 'reason', 'createdAt', 'createdBy'
        ])
        && adjustmentId.size() > 0
        && adjustmentId.size() <= 160
        && validShopId(data.shopId)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && data.direction in ['add', 'deduct']
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 160
        && data.reason.matches('.*[^ ].*')
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && data.createdBy.size() <= 160;
    }

    function validAdjustmentAuditCreate(adjustmentId) {
      let summaryPath = cashSummaryPath(request.resource.data.shopId);
      let summaryBefore = get(summaryPath);
      let summaryAfter = getAfter(summaryPath);
      return isAdmin()
        && validCashAdjustment(request.resource.data, adjustmentId)
        && exists(summaryPath)
        && existsAfter(summaryPath)
        && summaryAfter.data.lastCashOperationId == adjustmentId
        && summaryAfter.data.lastCashOperationType == 'adjustment'
        && summaryAfter.data.availableBalance
          == summaryBefore.data.availableBalance
            + (request.resource.data.direction == 'add'
              ? request.resource.data.amount
              : -request.resource.data.amount);
    }

    function validAdjustmentShopCashUpdate(shopId) {
      let adjustmentId = request.resource.data.lastCashOperationId;
      let adjustmentPath = cashAdjustmentPath(adjustmentId);
      let adjustmentAfter = getAfter(adjustmentPath);
      return isAdmin()
        && !exists(adjustmentPath)
        && existsAfter(adjustmentPath)
        && adjustmentAfter.data.shopId == shopId
        && isInitializedShopCash(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availableBalance',
          'lastCashOperationId',
          'lastCashOperationType',
          'updatedAt'
        ])
        && request.resource.data.availableBalance >= 0
        && request.resource.data.availableBalance
          == resource.data.availableBalance
            + (adjustmentAfter.data.direction == 'add'
              ? adjustmentAfter.data.amount
              : -adjustmentAfter.data.amount);
    }

    function validCashInitialization(data, shopId) {
      return data.keys().hasOnly(['shopId', 'openingBalance', 'createdAt', 'createdBy'])
        && data.shopId == shopId
        && validShopId(data.shopId)
        && data.openingBalance is number
        && data.openingBalance >= 0
        && data.openingBalance <= 100000000
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && data.createdBy.size() <= 160;
    }

    function validNewInitializationSummary(initialization, summary) {
      return summary.keys().hasOnly([
          'shopId',
          'availableBalance',
          'totalCollections',
          'totalExpenses',
          'totalTransferredIn',
          'totalTransferredOut',
          'openingBalance',
          'lastCashOperationId',
          'lastCashOperationType',
          'initializedAt',
          'initializedBy',
          'updatedAt'
        ])
        && summary.availableBalance == initialization.openingBalance
        && summary.totalCollections == 0
        && summary.totalExpenses == 0
        && summary.totalTransferredIn == 0
        && summary.totalTransferredOut == 0;
    }

    function validExistingInitializationSummary(initialization, beforeSummary, afterSummary) {
      return !isInitializedShopCash(beforeSummary)
        && afterSummary.diff(beforeSummary).affectedKeys().hasOnly([
          'availableBalance',
          'totalExpenses',
          'totalTransferredIn',
          'totalTransferredOut',
          'openingBalance',
          'lastCashOperationId',
          'lastCashOperationType',
          'initializedAt',
          'initializedBy',
          'updatedAt'
        ])
        && afterSummary.availableBalance
          == beforeSummary.availableBalance + initialization.openingBalance
        && afterSummary.totalCollections == beforeSummary.totalCollections
        && cashNumber(afterSummary, 'totalExpenses') == cashNumber(beforeSummary, 'totalExpenses')
        && cashNumber(afterSummary, 'totalTransferredIn') == cashNumber(beforeSummary, 'totalTransferredIn')
        && cashNumber(afterSummary, 'totalTransferredOut') == cashNumber(beforeSummary, 'totalTransferredOut');
    }

    function validInitializationSummaryIdentity(shopId, initialization, summary) {
      return isInitializedShopCash(summary)
        && summary.availableBalance >= 0
        && summary.openingBalance == initialization.openingBalance
        && summary.lastCashOperationId == shopId
        && summary.lastCashOperationType == 'initialization'
        && summary.initializedAt == request.time
        && summary.initializedBy == initialization.createdBy;
    }

    function validInitializationAuditCreate(shopId) {
      let summaryPath = cashSummaryPath(shopId);
      let summaryAfter = getAfter(summaryPath);
      return isAdmin()
        && validCashInitialization(request.resource.data, shopId)
        && existsAfter(summaryPath)
        && validInitializationSummaryIdentity(
          shopId,
          request.resource.data,
          summaryAfter.data
        );
    }

    function validInitializationShopCashWrite(shopId) {
      let initializationPath = cashInitializationPath(shopId);
      let initializationAfter = getAfter(initializationPath);
      return isAdmin()
        && !exists(initializationPath)
        && existsAfter(initializationPath)
        && validCashInitialization(initializationAfter.data, shopId)
        && validInitializationSummaryIdentity(
          shopId,
          initializationAfter.data,
          request.resource.data
        );
    }

    function validInitializationShopCashCreate(shopId) {
      let initialization = getAfter(cashInitializationPath(shopId)).data;
      return validInitializationShopCashWrite(shopId)
        && validNewInitializationSummary(initialization, request.resource.data);
    }

    function validInitializationShopCashUpdate(shopId) {
      let initialization = getAfter(cashInitializationPath(shopId)).data;
      return validInitializationShopCashWrite(shopId)
        && validExistingInitializationSummary(
          initialization,
          resource.data,
          request.resource.data
        );
    }

    function isPartnerLevel(level) {
      return level in ['Active Partner', 'Silver Partner', 'Gold Partner', 'Platinum Partner'];
    }

    function isCustomerTier(tier) {
      return tier in ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4'];
    }

    function isRedemptionStatus(status) {
      return status in ['Pending', 'Approved', 'Rejected', 'Gifted'];
    }

    function validOptionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    function validMonthlyCustomerStats(data) {
      return data.keys().hasOnly([
          'id',
          'customerId',
          'month',
          'totalSales',
          'totalProfit',
          'totalPayments',
          'orderCount',
          'overdueAmount',
          'target',
          'basePcEarned',
          'bonusPcEarned',
          'availablePc',
          'salesTarget',
          'profitTarget',
          'frequencyTarget',
          'paymentScore',
          'profitScore',
          'frequencyScore',
          'salesScore',
          'loyaltyScore',
          'rollingScore',
          'calculatedTier',
          'finalTier',
          'tierCapReason',
          'isOnboarding',
          'onboardingStage',
          'confidenceFactor',
          'pointsEarned',
          'currentLevel',
          'progressPercent',
          'updatedAt'
        ])
        && data.id is string
        && data.customerId is string
        && data.month is string
        && data.month.matches('^\\d{4}-\\d{2}$')
        && data.totalSales is number
        && (!('totalProfit' in data) || data.totalProfit is number)
        && data.totalPayments is number
        && data.orderCount is number
        && data.overdueAmount is number
        && data.target is number
        && (!('basePcEarned' in data) || data.basePcEarned is number)
        && (!('bonusPcEarned' in data) || data.bonusPcEarned is number)
        && (!('availablePc' in data) || data.availablePc is number)
        && (!('salesTarget' in data) || data.salesTarget is number)
        && (!('profitTarget' in data) || data.profitTarget is number)
        && (!('frequencyTarget' in data) || data.frequencyTarget is number)
        && (!('paymentScore' in data) || data.paymentScore is number)
        && (!('profitScore' in data) || data.profitScore is number)
        && (!('frequencyScore' in data) || data.frequencyScore is number)
        && (!('salesScore' in data) || data.salesScore is number)
        && (!('loyaltyScore' in data) || data.loyaltyScore is number)
        && (!('rollingScore' in data) || data.rollingScore is number)
        && (!('calculatedTier' in data) || isCustomerTier(data.calculatedTier))
        && (!('finalTier' in data) || isCustomerTier(data.finalTier))
        && validOptionalString(data, 'tierCapReason', 240)
        && (!('isOnboarding' in data) || data.isOnboarding is bool)
        && (!('onboardingStage' in data) || data.onboardingStage in ['None', 'Stage A', 'Stage B', 'Stage C', 'Stage D'])
        && (!('confidenceFactor' in data) || data.confidenceFactor is number)
        && data.pointsEarned is number
        && data.progressPercent is number
        && data.totalSales >= 0
        && data.totalPayments >= 0
        && data.orderCount >= 0
        && data.overdueAmount >= 0
        && data.target >= 0
        && (!('basePcEarned' in data) || data.basePcEarned >= 0)
        && (!('bonusPcEarned' in data) || data.bonusPcEarned >= 0)
        && (!('availablePc' in data) || data.availablePc >= 0)
        && (!('salesTarget' in data) || data.salesTarget >= 0)
        && (!('profitTarget' in data) || data.profitTarget >= 0)
        && (!('frequencyTarget' in data) || data.frequencyTarget >= 0)
        && (!('paymentScore' in data) || (data.paymentScore >= 0 && data.paymentScore <= 100))
        && (!('profitScore' in data) || (data.profitScore >= 0 && data.profitScore <= 100))
        && (!('frequencyScore' in data) || (data.frequencyScore >= 0 && data.frequencyScore <= 100))
        && (!('salesScore' in data) || (data.salesScore >= 0 && data.salesScore <= 100))
        && (!('loyaltyScore' in data) || (data.loyaltyScore >= 0 && data.loyaltyScore <= 100))
        && (!('rollingScore' in data) || (data.rollingScore >= 0 && data.rollingScore <= 100))
        && (!('confidenceFactor' in data) || (data.confidenceFactor >= 0 && data.confidenceFactor <= 1))
        && data.pointsEarned >= 0
        && data.progressPercent >= 0
        && data.progressPercent <= 100
        && isPartnerLevel(data.currentLevel)
        && data.updatedAt is string;
    }

    function validLoyaltyLedgerEntry(data) {
      return data.keys().hasOnly([
          'customerId',
          'type',
          'points',
          'reason',
          'referenceId',
          'month',
          'createdAt'
        ])
        && data.customerId is string
        && data.type in ['purchase', 'on_time_payment', 'monthly_target', 'order_frequency', 'overdue_payment', 'bonus', 'redemption', 'opening_balance', 'manual_adjustment', 'redemption_reversal']
        && data.points is number
        && ((data.type == 'manual_adjustment' && data.points != 0)
          || (data.type == 'redemption' && data.points < 0)
          || (data.type == 'opening_balance' && data.points >= 0)
          || (data.type == 'on_time_payment' && data.points >= 0)
          || (!(data.type in ['manual_adjustment', 'redemption', 'opening_balance', 'on_time_payment']) && data.points > 0))
        && data.reason is string
        && data.reason.size() <= 160
        && data.referenceId is string
        && data.referenceId.size() <= 160
        && data.month is string
        && data.month.matches('^\\d{4}-\\d{2}$')
        && data.createdAt is string;
    }

    function validPcBalance(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId',
          'availablePc',
          'incomingPc',
          'redeemedPc',
          'protectedAt',
          'lastAwardReferenceId',
          'lastMutationReferenceId',
          'updatedAt'
        ])
        && data.customerId == customerDocId
        && data.availablePc is number
        && data.availablePc >= 0
        && data.incomingPc is number
        && data.incomingPc >= 0
        && data.redeemedPc is number
        && data.redeemedPc >= 0
        && data.availablePc == data.incomingPc - data.redeemedPc
        && data.protectedAt is string
        && validOptionalString(data, 'lastAwardReferenceId', 160)
        && validOptionalString(data, 'lastMutationReferenceId', 500)
        && data.updatedAt is string;
    }

    function pcBalancePath(customerDocId) {
      return /databases/$(database)/documents/pcBalances/$(customerDocId);
    }

    function invoicePath(invoiceId) {
      return /databases/$(database)/documents/invoices/$(invoiceId);
    }

    function loyaltyLedgerPath(entryId) {
      return /databases/$(database)/documents/loyaltyLedger/$(entryId);
    }

    function validPcMutationActor(entryType) {
      return (entryType == 'on_time_payment' && isTeam())
        || (entryType != 'on_time_payment' && isAdmin());
    }

    function validInvoicePcPolicyVersionOnCreate() {
      return !('pcPolicyVersionAtInvoice' in request.resource.data)
        || (request.resource.data.pcPolicyVersionAtInvoice is int
          && request.resource.data.pcPolicyVersionAtInvoice >= 0);
    }

    function preservesInvoicePcPolicyVersion() {
      return (
          !('pcPolicyVersionAtInvoice' in resource.data)
          && !('pcPolicyVersionAtInvoice' in request.resource.data)
        )
        || (
          'pcPolicyVersionAtInvoice' in resource.data
          && 'pcPolicyVersionAtInvoice' in request.resource.data
          && request.resource.data.pcPolicyVersionAtInvoice == resource.data.pcPolicyVersionAtInvoice
        );
    }

    function validPaymentPcPolicyVersionOnCreate() {
      return !('pcPolicyVersionAtPayment' in request.resource.data)
        || (request.resource.data.pcPolicyVersionAtPayment is int
          && request.resource.data.pcPolicyVersionAtPayment >= 0);
    }

    function preservesPaymentPcPolicyVersion() {
      return (
          !('pcPolicyVersionAtPayment' in resource.data)
          && !('pcPolicyVersionAtPayment' in request.resource.data)
        )
        || (
          'pcPolicyVersionAtPayment' in resource.data
          && 'pcPolicyVersionAtPayment' in request.resource.data
          && request.resource.data.pcPolicyVersionAtPayment == resource.data.pcPolicyVersionAtPayment
        );
    }

    function validInvoicePcMutation(entryId, entry) {
      let linkedInvoicePath = invoicePath(entry.referenceId);
      return entry.type != 'on_time_payment'
        || (
          entryId == entry.customerId + "_" + entry.referenceId + "_invoice_pc"
          && exists(linkedInvoicePath)
          && get(linkedInvoicePath).data.customerId == entry.customerId
        );
    }

    function validPcBalanceLedgerCreate(customerDocId) {
      let entryId = request.resource.data.lastMutationReferenceId;
      let entryPath = loyaltyLedgerPath(entryId);
      let entry = getAfter(entryPath).data;
      return validPcBalance(request.resource.data, customerDocId)
        && entryId is string
        && !exists(entryPath)
        && existsAfter(entryPath)
        && validLoyaltyLedgerEntry(entry)
        && validPcMutationActor(entry.type)
        && validInvoicePcMutation(entryId, entry)
        && entry.customerId == customerDocId
        && request.resource.data.availablePc == entry.points
        && request.resource.data.incomingPc == entry.points
        && request.resource.data.redeemedPc == 0
        && request.resource.data.updatedAt == entry.createdAt
        && (
          (entry.type == 'opening_balance'
            && entry.points >= 0
            && request.resource.data.protectedAt == entry.createdAt)
          || (entry.type in ['on_time_payment', 'purchase', 'monthly_target', 'order_frequency', 'overdue_payment', 'bonus', 'manual_adjustment']
            && entry.points > 0
            && request.resource.data.protectedAt == '')
        )
        && (entry.type != 'on_time_payment'
          || request.resource.data.lastAwardReferenceId == entry.referenceId);
    }

    function validPcBalanceLedgerUpdate(customerDocId) {
      let entryId = request.resource.data.lastMutationReferenceId;
      let entryPath = loyaltyLedgerPath(entryId);
      let entry = getAfter(entryPath).data;
      let availableDelta = request.resource.data.availablePc - resource.data.availablePc;
      let incomingDelta = request.resource.data.incomingPc - resource.data.incomingPc;
      let redeemedDelta = request.resource.data.redeemedPc - resource.data.redeemedPc;
      return validPcBalance(request.resource.data, customerDocId)
        && entryId is string
        && !exists(entryPath)
        && existsAfter(entryPath)
        && validLoyaltyLedgerEntry(entry)
        && validPcMutationActor(entry.type)
        && validInvoicePcMutation(entryId, entry)
        && entry.customerId == customerDocId
        && request.resource.data.protectedAt == resource.data.protectedAt
        && request.resource.data.updatedAt == entry.createdAt
        && (
          (entry.type in ['on_time_payment', 'purchase', 'monthly_target', 'order_frequency', 'overdue_payment', 'bonus', 'manual_adjustment']
            && entry.points > 0
            && availableDelta == entry.points
            && incomingDelta == entry.points
            && redeemedDelta == 0)
          || (entry.type in ['manual_adjustment', 'redemption']
            && entry.points < 0
            && availableDelta == entry.points
            && incomingDelta == 0
            && redeemedDelta == -entry.points)
          || (entry.type == 'redemption_reversal'
            && entry.points > 0
            && availableDelta == entry.points
            && incomingDelta == 0
            && redeemedDelta == -entry.points)
        )
        && (entry.type != 'on_time_payment'
          || request.resource.data.lastAwardReferenceId == entry.referenceId);
    }

    function validTeamInvoicePcLedger(entryId, data) {
      let balancePath = pcBalancePath(data.customerId);
      let linkedInvoicePath = invoicePath(data.referenceId);
      return isTeam()
        && validLoyaltyLedgerEntry(data)
        && data.type == 'on_time_payment'
        && data.points >= 0
        && data.points <= 1000000
        && entryId == data.customerId + "_" + data.referenceId + "_invoice_pc"
        && exists(linkedInvoicePath)
        && get(linkedInvoicePath).data.customerId == data.customerId
        && (
          data.points == 0
          || (
            existsAfter(balancePath)
            && getAfter(balancePath).data.lastAwardReferenceId == data.referenceId
            && getAfter(balancePath).data.lastMutationReferenceId == entryId
            && getAfter(balancePath).data.updatedAt == data.createdAt
            && (
              (
                exists(balancePath)
                && getAfter(balancePath).data.availablePc == get(balancePath).data.availablePc + data.points
                && getAfter(balancePath).data.incomingPc == get(balancePath).data.incomingPc + data.points
                && getAfter(balancePath).data.redeemedPc == get(balancePath).data.redeemedPc
                && getAfter(balancePath).data.protectedAt == get(balancePath).data.protectedAt
              )
              || (
                !exists(balancePath)
                && getAfter(balancePath).data.availablePc == data.points
                && getAfter(balancePath).data.incomingPc == data.points
                && getAfter(balancePath).data.redeemedPc == 0
                && getAfter(balancePath).data.protectedAt == ''
              )
            )
          )
        );
    }

    function validRewardItem(data) {
      return data.keys().hasOnly([
          'name',
          'requiredPoints',
          'levelRequired',
          'isActive',
          'description',
          'imageUrl',
          'imagePath',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.requiredPoints is number
        && data.requiredPoints >= 0
        && isPartnerLevel(data.levelRequired)
        && data.isActive is bool
        && validOptionalString(data, 'description', 500)
        && validOptionalString(data, 'imageUrl', 1200)
        && validOptionalString(data, 'imagePath', 500)
        && validOptionalString(data, 'createdAt', 40)
        && validOptionalString(data, 'updatedAt', 40);
    }

    function validOffer(data) {
      return data.keys().hasOnly([
          'title',
          'description',
          'imageUrl',
          'imagePath',
          'levelRequired',
          'startDate',
          'endDate',
          'isActive',
          'createdAt',
          'createdBy',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && validOptionalString(data, 'description', 1000)
        && validOptionalString(data, 'imageUrl', 1200)
        && validOptionalString(data, 'imagePath', 500)
        && (!('levelRequired' in data) || isPartnerLevel(data.levelRequired))
        && data.startDate is string
        && data.endDate is string
        && data.isActive is bool
        && validOptionalString(data, 'createdAt', 40)
        && validOptionalString(data, 'createdBy', 160)
        && validOptionalString(data, 'updatedAt', 40);
    }

    function validRedemptionRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'rewardId',
          'rewardName',
          'points',
          'status',
          'requestedAt',
          'reviewedAt',
          'reviewedBy',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.rewardId is string
        && data.rewardName is string
        && data.rewardName.size() <= 120
        && data.points is number
        && data.points >= 0
        && isRedemptionStatus(data.status)
        && data.requestedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'notes', 500);
    }

    function validOverduePcRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'invoiceId',
          'invoiceNumber',
          'invoiceDate',
          'dueDate',
          'fullPaymentDate',
          'overdueDays',
          'invoiceAmount',
          'suggestedCoins',
          'approvedCoins',
          'status',
          'generatedAt',
          'reviewedAt',
          'reviewedBy',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.invoiceId is string
        && data.invoiceNumber is string
        && data.invoiceNumber.size() <= 80
        && data.invoiceDate is string
        && data.dueDate is string
        && data.fullPaymentDate is string
        && data.overdueDays is number
        && data.overdueDays >= 0
        && data.invoiceAmount is number
        && data.invoiceAmount >= 0
        && data.suggestedCoins is number
        && data.suggestedCoins >= 0
        && data.approvedCoins is number
        && data.approvedCoins >= 0
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.generatedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'notes', 500);
    }

    function isBonusPcType(type) {
      return type in ['monthly_target', 'clean_payment_month', 'new_customer', 'referral'];
    }

    function fixedBonusPc(type) {
      return type == 'monthly_target' || type == 'clean_payment_month'
        ? 5
        : type == 'new_customer'
          ? 20
          : type == 'referral'
            ? 50
            : -1;
    }

    function validBonusPcRequest(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'bonusType',
          'bonusLabel',
          'triggerType',
          'referenceId',
          'suggestedCoins',
          'approvedCoins',
          'status',
          'generatedAt',
          'reviewedAt',
          'reviewedBy',
          'customerSeenAt',
          'notes'
        ])
        && data.customerId is string
        && data.customerName is string
        && data.customerName.size() <= 140
        && isBonusPcType(data.bonusType)
        && data.bonusLabel is string
        && data.bonusLabel.size() <= 80
        && data.triggerType is string
        && data.triggerType.size() <= 80
        && data.referenceId is string
        && data.referenceId.size() <= 160
        && data.suggestedCoins is number
        && data.suggestedCoins == fixedBonusPc(data.bonusType)
        && data.approvedCoins is number
        && data.approvedCoins in [0, fixedBonusPc(data.bonusType)]
        && data.status in ['Pending', 'Approved', 'Rejected']
        && data.generatedAt is string
        && validOptionalString(data, 'reviewedAt', 40)
        && validOptionalString(data, 'reviewedBy', 160)
        && validOptionalString(data, 'customerSeenAt', 40)
        && validOptionalString(data, 'notes', 500);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'role',
          'customerId',
          'customerName',
          'shopId',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 160
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 140
        && data.role in ['Admin', 'Staff', 'customer', 'Medical']
        && data.active is bool
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && validOptionalString(data, 'customerId', 160)
        && validOptionalString(data, 'customerName', 140)
        && (!('shopId' in data) || (data.role == 'Staff' && validShopId(data.shopId)));
    }

    function validCreditOverride(data) {
      return data is map
        && data.keys().hasOnly(['amount', 'reason', 'expiresAt', 'createdAt', 'createdBy'])
        && data.amount is number
        && data.amount >= 0
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 500
        && data.expiresAt is string
        && data.expiresAt.size() == 10
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 160;
    }

    function validCreditProfile(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'tier',
          'creditDays',
          'currentOutstanding',
          'creditHistoryDays',
          'totalCreditInvoiceAmountInLookback',
          'totalCreditInvoiceAmountLast90Days',
          'averageMonthlyCreditSales',
          'recentMonthlyCompletedCreditSales',
          'representativeInvoiceValue',
          'effectiveCycleDays',
          'baseCreditLimit',
          'calculatedCreditLimit',
          'approvedCreditLimit',
          'availableCredit',
          'overLimitAmount',
          'paymentFactor',
          'historyFactor',
          'creditPaymentScore',
          'weightedLateDays',
          'onTimePaymentPercentage',
          'completedCreditInvoices',
          'overdueAmount',
          'oldestOverdueInvoice',
          'oldestOverdueDate',
          'oldestOverdueDays',
          'hasOverdueBeyondGrace',
          'creditStatus',
          'creditLimitApprovalStatus',
          'nextInvoiceDueDate',
          'nextInvoiceDueAmount',
          'lastCreditReviewAt',
          'lastCreditReviewReason',
          'manualHold',
          'manualStarterLimit',
          'limitSource',
          'creditOverride',
          'updatedAt'
        ])
        && data.customerId == customerDocId
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 140
        && data.tier in ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4']
        && data.creditDays is int
        && data.creditDays >= 0
        && data.creditHistoryDays in [60, 90]
        && data.currentOutstanding is number
        && data.currentOutstanding >= 0
        && data.totalCreditInvoiceAmountInLookback is number
        && data.totalCreditInvoiceAmountInLookback >= 0
        && data.totalCreditInvoiceAmountLast90Days is number
        && data.totalCreditInvoiceAmountLast90Days >= 0
        && data.averageMonthlyCreditSales is number
        && data.averageMonthlyCreditSales >= 0
        && data.recentMonthlyCompletedCreditSales is number
        && data.recentMonthlyCompletedCreditSales >= 0
        && data.representativeInvoiceValue is number
        && data.representativeInvoiceValue >= 0
        && data.effectiveCycleDays is number
        && data.effectiveCycleDays >= 3
        && data.effectiveCycleDays <= 20
        && data.baseCreditLimit is number
        && data.baseCreditLimit >= 0
        && data.calculatedCreditLimit is number
        && data.calculatedCreditLimit >= 0
        && data.approvedCreditLimit is number
        && data.approvedCreditLimit >= 0
        && data.availableCredit is number
        && data.availableCredit >= 0
        && data.overLimitAmount is number
        && data.overLimitAmount >= 0
        && data.paymentFactor is number
        && data.paymentFactor >= 0
        && data.historyFactor is number
        && data.historyFactor >= 0
        && data.creditPaymentScore is number
        && data.creditPaymentScore >= 0
        && data.creditPaymentScore <= 100
        && data.weightedLateDays is number
        && data.weightedLateDays >= 0
        && data.onTimePaymentPercentage is number
        && data.onTimePaymentPercentage >= 0
        && data.onTimePaymentPercentage <= 100
        && data.completedCreditInvoices is int
        && data.completedCreditInvoices >= 0
        && data.overdueAmount is number
        && data.overdueAmount >= 0
        && data.oldestOverdueInvoice is string
        && data.oldestOverdueInvoice.size() <= 80
        && (data.oldestOverdueDate == null || (data.oldestOverdueDate is string && data.oldestOverdueDate.size() == 10))
        && data.oldestOverdueDays is number
        && data.oldestOverdueDays >= 0
        && data.hasOverdueBeyondGrace is bool
        && data.creditStatus in ['starter', 'active', 'hold', 'disabled']
        && data.creditLimitApprovalStatus in ['pending_starter', 'pending_calculated', 'approved', 'rejected']
        && (data.nextInvoiceDueDate == null || (data.nextInvoiceDueDate is string && data.nextInvoiceDueDate.size() == 10))
        && (data.nextInvoiceDueAmount == null || (data.nextInvoiceDueAmount is number && data.nextInvoiceDueAmount >= 0))
        && data.lastCreditReviewAt is string
        && data.lastCreditReviewAt.size() <= 40
        && data.lastCreditReviewReason is string
        && data.lastCreditReviewReason.size() > 0
        && data.lastCreditReviewReason.size() <= 500
        && data.manualHold is bool
        && data.limitSource is string
        && data.limitSource.size() > 0
        && data.limitSource.size() <= 80
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && (!('manualStarterLimit' in data) || (data.manualStarterLimit is number && data.manualStarterLimit >= 0 && data.manualStarterLimit <= 10000))
        && (!('creditOverride' in data) || validCreditOverride(data.creditOverride));
    }

    function staffPreservesCreditControls(data) {
      return (
          (!('manualStarterLimit' in resource.data) && !('manualStarterLimit' in data))
          || ('manualStarterLimit' in resource.data && 'manualStarterLimit' in data && data.manualStarterLimit == resource.data.manualStarterLimit)
          || ('manualStarterLimit' in resource.data && resource.data.manualStarterLimit > 10000 && data.manualStarterLimit == 10000)
        )
        && (
          (!('creditOverride' in resource.data) && !('creditOverride' in data))
          || ('creditOverride' in resource.data && 'creditOverride' in data && data.creditOverride == resource.data.creditOverride)
        )
        && (
          (('manualHold' in resource.data) && data.manualHold == resource.data.manualHold)
          || (!('manualHold' in resource.data) && data.manualHold == false)
        );
    }

    function validCreditSummary(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId',
          'suggestedCreditLimit',
          'calculatedCreditLimit',
          'approvedCreditLimit',
          'availableCredit',
          'usedCredit',
          'overLimitAmount',
          'creditDays',
          'limitSource',
          'oldestOverdueInvoice',
          'oldestOverdueDate',
          'oldestOverdueDays',
          'nextInvoiceDueDate',
          'nextInvoiceDueAmount',
          'creditStatus',
          'manualHold',
          'updatedAt'
        ])
        && data.customerId == customerDocId
        && data.suggestedCreditLimit is number
        && data.suggestedCreditLimit >= 0
        && data.calculatedCreditLimit is number
        && data.calculatedCreditLimit >= 0
        && (!('approvedCreditLimit' in data) || (data.approvedCreditLimit is number && data.approvedCreditLimit >= 0))
        && data.availableCredit is number
        && data.availableCredit >= 0
        && data.usedCredit is number
        && data.usedCredit >= 0
        && data.overLimitAmount is number
        && data.overLimitAmount >= 0
        && data.creditDays is int
        && data.creditDays >= 0
        && data.limitSource is string
        && data.limitSource.size() <= 80
        && data.oldestOverdueInvoice is string
        && data.oldestOverdueInvoice.size() <= 80
        && (data.oldestOverdueDate == null || (data.oldestOverdueDate is string && data.oldestOverdueDate.size() == 10))
        && data.oldestOverdueDays is number
        && data.oldestOverdueDays >= 0
        && (data.nextInvoiceDueDate == null || (data.nextInvoiceDueDate is string && data.nextInvoiceDueDate.size() == 10))
        && (data.nextInvoiceDueAmount == null || (data.nextInvoiceDueAmount is number && data.nextInvoiceDueAmount >= 0))
        && data.creditStatus in ['starter', 'active', 'hold', 'disabled']
        && (!('manualHold' in data) || data.manualHold is bool)
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validCreditAudit(data) {
      return data.keys().hasOnly([
          'customerId',
          'customerName',
          'action',
          'adminUid',
          'timestamp',
          'oldValue',
          'newValue',
          'reason'
        ])
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 160
        && data.customerName is string
        && data.customerName.size() <= 140
        && data.action in ['approve', 'reject', 'manual_starter', 'hold', 'remove_hold', 'override', 'remove_override']
        && data.adminUid == request.auth.uid
        && data.timestamp is string
        && data.timestamp.size() <= 40
        && (data.oldValue == null || (data.oldValue is map && data.oldValue.keys().size() <= 10))
        && (data.newValue == null || (data.newValue is map && data.newValue.keys().size() <= 10))
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 500;
    }

    function validInvoiceCounter(data) {
      return data.keys().hasOnly(['kind', 'prefix', 'scope', 'sequence', 'updatedAt'])
        && data.kind == 'invoice'
        && data.prefix is string
        && data.prefix.size() > 0
        && data.prefix.size() <= 40
        && data.scope is string
        && data.scope.size() > 0
        && data.scope.size() <= 40
        && data.sequence is int
        && data.sequence > 0
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validIntelligenceSummary(data, customerDocId) {
      return data.keys().hasOnly([
          'customerId', 'customerName', 'customerArea', 'customerMobile',
          'tier', 'storedTier', 'creditDays', 'creditBufferDays', 'creditPolicyLabel',
          'totalSales', 'totalProfit', 'totalPayments', 'outstanding', 'invoiceCount',
          'averageOrderValue', 'monthlySalesTarget', 'customerMonthlySales', 'salesTargetAchievement',
          'monthlyOrderTarget', 'customerMonthlyOrders', 'orderTargetAchievement', 'insights',
          'frequencyScore', 'paymentDisciplineScore', 'salesScore', 'profitScore', 'loyaltyScore',
          'intelligenceScore', 'giftBudget', 'rank', 'previousRank', 'previousScore', 'previousTier',
          'movement', 'movementReason', 'riskLevel', 'recommendedAction', 'overdueStatus',
          'tierCapReason', 'isOnboarding', 'onboardingStage', 'confidenceFactor',
          'scoreBreakdown', 'calculatedAt'
        ])
        && data.customerId == customerDocId
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 140
        && data.customerArea is string
        && data.customerArea.size() <= 140
        && data.customerMobile is string
        && data.customerMobile.size() <= 30
        && isCustomerTier(data.tier)
        && isCustomerTier(data.storedTier)
        && data.creditDays is number
        && data.creditDays >= 0
        && data.creditBufferDays is number
        && data.creditBufferDays >= 0
        && data.creditPolicyLabel is string
        && data.creditPolicyLabel.size() <= 100
        && data.totalSales is number
        && data.totalProfit is number
        && data.totalPayments is number
        && data.outstanding is number
        && data.outstanding >= 0
        && data.invoiceCount is number
        && data.invoiceCount >= 0
        && data.averageOrderValue is number
        && data.monthlySalesTarget is number
        && data.customerMonthlySales is number
        && data.salesTargetAchievement is number
        && data.monthlyOrderTarget is number
        && data.customerMonthlyOrders is number
        && data.orderTargetAchievement is number
        && data.insights is list
        && data.insights.size() <= 12
        && data.frequencyScore is number
        && data.frequencyScore >= 0 && data.frequencyScore <= 100
        && data.paymentDisciplineScore is number
        && data.paymentDisciplineScore >= 0 && data.paymentDisciplineScore <= 100
        && data.salesScore is number
        && data.salesScore >= 0 && data.salesScore <= 100
        && data.profitScore is number
        && data.profitScore >= 0 && data.profitScore <= 100
        && data.loyaltyScore is number
        && data.loyaltyScore >= 0 && data.loyaltyScore <= 100
        && data.intelligenceScore is number
        && data.intelligenceScore >= 0 && data.intelligenceScore <= 100
        && data.giftBudget is number
        && data.giftBudget >= 0
        && data.rank is number
        && data.rank >= 0
        && (!('previousRank' in data) || data.previousRank is number)
        && (!('previousScore' in data) || data.previousScore is number)
        && (!('previousTier' in data) || isCustomerTier(data.previousTier))
        && data.movement in ['Promoted', 'Demoted', 'Stable', 'New']
        && data.movementReason is string
        && data.movementReason.size() <= 500
        && data.riskLevel in ['Low', 'Medium', 'High']
        && data.recommendedAction is string
        && data.recommendedAction.size() <= 500
        && data.overdueStatus is string
        && data.overdueStatus.size() <= 160
        && validOptionalString(data, 'tierCapReason', 500)
        && data.isOnboarding is bool
        && data.onboardingStage in ['None', 'Stage A', 'Stage B', 'Stage C', 'Stage D']
        && data.confidenceFactor is number
        && data.confidenceFactor >= 0 && data.confidenceFactor <= 1
        && data.scoreBreakdown is list
        && data.scoreBreakdown.size() == 5
        && data.calculatedAt is string
        && data.calculatedAt.size() <= 40;
    }

    function validCustomerMonthlySnapshot(data, snapshotId) {
      return data.keys().hasOnly([
          'customerId', 'month', 'totalSales', 'totalProfit', 'invoiceCount',
          'paymentsReceived', 'needsBackfill', 'updatedAt'
        ])
        && snapshotId == data.customerId + '_' + data.month
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 160
        && data.month is string
        && data.month.size() == 7
        && data.totalSales is number
        && data.totalSales >= 0
        && data.totalProfit is number
        && data.invoiceCount is number
        && data.invoiceCount >= 0
        && data.paymentsReceived is number
        && data.paymentsReceived >= 0
        && data.needsBackfill is bool
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validBusinessMonthlySnapshot(data, snapshotId) {
      return data.keys().hasOnly([
          'month', 'totalSales', 'totalProfit', 'invoiceCount',
          'paymentsReceived', 'needsBackfill', 'updatedAt'
        ])
        && snapshotId == data.month
        && data.month is string
        && data.month.size() == 7
        && data.totalSales is number
        && data.totalSales >= 0
        && data.totalProfit is number
        && data.invoiceCount is number
        && data.invoiceCount >= 0
        && data.paymentsReceived is number
        && data.paymentsReceived >= 0
        && data.needsBackfill is bool
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.uid == request.auth.uid
            || resource.data.email == request.auth.token.email
          )
        );

      allow create: if isAdmin()
        && validUserProfile(request.resource.data);

      allow update: if isAdmin()
        && validUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      // Profile removal revokes app access without requiring a paid backend.
      // Firebase Authentication credential cleanup remains a Console action.
      allow delete: if isAdmin()
        && resource.data.uid != request.auth.uid
        && resource.data.role in ['Staff', 'customer', 'Medical'];
    }

    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /customers/{customerDocId} {
      allow read: if isTeam() || (isCustomer() && customerDocId == customerId()) || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if isTeam()
        && validInvoicePcPolicyVersionOnCreate()
        && validBranchCreateForActor(request.resource.data);
      allow update: if isTeam()
        && preservesInvoicePcPolicyVersion()
        && validInvoiceBranchUpdateForActor();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if isTeam()
        && validPaymentPcPolicyVersionOnCreate()
        && validBranchCreateForActor(request.resource.data)
        && validPaymentCashFields(request.resource.data)
        && validPaymentCashMutation(paymentId);
      allow update: if isTeam()
        && preservesPaymentPcPolicyVersion()
        && validPaymentBranchUpdateForActor()
        && validPaymentCashFields(request.resource.data)
        && validPaymentCashMutation(paymentId);
      allow delete: if isAdmin()
        && (validInvoiceDeletePaymentCashMutation() || validPaymentCashMutation(paymentId));
    }

    match /shopCash/{shopId} {
      allow get: if isAdmin() || (hasAssignedShop() && profile().shopId == shopId);
      allow list: if false;
      allow create: if validShopCash(request.resource.data, shopId)
        && request.resource.data.keys().hasAll([
          'lastCashOperationId', 'lastCashOperationType'
        ])
        && (
          (request.resource.data.lastCashOperationType == 'payment'
            && validPaymentShopCashCreate(shopId))
          || (request.resource.data.lastCashOperationType == 'initialization'
            && validInitializationShopCashCreate(shopId))
        );
      allow update: if validShopCash(request.resource.data, shopId)
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.keys().hasAll([
          'lastCashOperationId', 'lastCashOperationType'
        ])
        && (
          (request.resource.data.lastCashOperationType == 'payment'
            && validPaymentShopCashUpdate(shopId))
          || (request.resource.data.lastCashOperationType == 'invoice_delete'
            && validInvoiceDeleteShopCashUpdate(shopId))
          || (request.resource.data.lastCashOperationType == 'expense'
            && validExpenseShopCashUpdate(shopId))
          || (request.resource.data.lastCashOperationType == 'transfer'
            && validTransferShopCashUpdate(shopId))
          || (request.resource.data.lastCashOperationType == 'transfer_edit'
            && validTransferEditShopCashUpdate(shopId))
          || (request.resource.data.lastCashOperationType == 'adjustment'
            && validAdjustmentShopCashUpdate(shopId))
          || (request.resource.data.lastCashOperationType == 'initialization'
            && validInitializationShopCashUpdate(shopId))
        );
      allow delete: if false;
    }

    match /cashExpenses/{expenseId} {
      allow read: if isAdmin()
        || (hasAssignedShop() && resource.data.shopId == profile().shopId);
      allow create: if validExpenseAuditCreate(expenseId);
      allow update, delete: if false;
    }

    match /shopTransfers/{transferId} {
      allow read: if isAdmin();
      allow read: if hasAssignedShop()
        && resource.data.fromShopId == profile().shopId;
      allow read: if hasAssignedShop()
        && resource.data.toShopId == profile().shopId;
      allow create: if validTransferAuditCreate(transferId);
      allow update: if validTransferAuditUpdate(transferId);
      allow delete: if false;
    }

    match /cashAdjustments/{adjustmentId} {
      allow read: if isAdmin()
        || (hasAssignedShop() && resource.data.shopId == profile().shopId);
      allow create: if validAdjustmentAuditCreate(adjustmentId);
      allow update, delete: if false;
    }

    match /cashInitializations/{shopId} {
      allow read: if isAdmin();
      allow create: if validInitializationAuditCreate(shopId);
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      allow get: if isTeam();
      allow list: if false;
      allow create: if isTeam()
        && validInvoiceCounter(request.resource.data);
      allow update: if isTeam()
        && validInvoiceCounter(request.resource.data)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.prefix == resource.data.prefix
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.sequence == resource.data.sequence + 1;
      allow delete: if false;
    }

    match /customerCreditProfiles/{customerDocId} {
      allow get: if isTeam();
      allow list: if isAdmin();
      allow create: if validCreditProfile(request.resource.data, customerDocId)
        && (
          isAdmin()
          || (isStaff()
            && request.resource.data.manualHold == false
            && !('manualStarterLimit' in request.resource.data)
            && !('creditOverride' in request.resource.data))
        );
      allow update: if validCreditProfile(request.resource.data, customerDocId)
        && (isAdmin() || (isStaff() && staffPreservesCreditControls(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /customerCreditSummaries/{customerDocId} {
      allow get: if isTeam() || (isCustomer() && customerDocId == customerId());
      allow list: if isTeam();
      allow create, update: if isTeam() && validCreditSummary(request.resource.data, customerDocId);
      allow delete: if isAdmin();
    }

    match /customerIntelligenceSummaries/{customerDocId} {
      allow get: if isTeam() || (isCustomer() && customerDocId == customerId());
      allow list: if isTeam();
      allow create, update: if isTeam() && validIntelligenceSummary(request.resource.data, customerDocId);
      allow delete: if isAdmin();
    }

    match /customerMonthlySnapshots/{snapshotId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isTeam() && validCustomerMonthlySnapshot(request.resource.data, snapshotId);
      allow delete: if isAdmin();
    }

    match /businessMonthlySnapshots/{snapshotId} {
      allow read: if isTeam();
      allow create, update: if isTeam() && validBusinessMonthlySnapshot(request.resource.data, snapshotId);
      allow delete: if isAdmin();
    }

    match /migrationStatus/{migrationId} {
      allow read, write: if isAdmin();
    }

    match /creditAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCreditAudit(request.resource.data);
      allow update, delete: if false;
    }

    match /giftHistory/{giftId} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /giftItems/{giftItemId} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isTeam() || (isCustomer() && resource.data.isActive == true);
      allow create, update: if isAdmin() && validOffer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /monthlyCustomerStats/{statsId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create, update: if isAdmin() && validMonthlyCustomerStats(request.resource.data);
      allow delete: if isAdmin();
    }

    match /loyaltyLedger/{entryId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if (isAdmin()
          && validLoyaltyLedgerEntry(request.resource.data)
          && (request.resource.data.type != 'on_time_payment' || request.resource.data.points > 0))
        || validTeamInvoicePcLedger(entryId, request.resource.data);
      allow update, delete: if false;
    }

    match /pcBalances/{customerDocId} {
      allow read: if isTeam() || (isCustomer() && customerId() == customerDocId);
      allow create: if validPcBalanceLedgerCreate(customerDocId);
      allow update: if validPcBalanceLedgerUpdate(customerDocId);
      allow delete: if false;
    }

    match /rewardItems/{rewardId} {
      allow read: if isTeam() || (isCustomer() && resource.data.isActive == true);
      allow create, update: if isAdmin() && validRewardItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /redemptionRequests/{requestId} {
      allow read: if isTeam() || ownsCustomerRecord(resource.data);
      allow create: if isCustomer()
        && validRedemptionRequest(request.resource.data)
        && ownsCustomerRecord(request.resource.data)
        && request.resource.data.status == 'Pending';
      allow update: if isCustomer()
        && ownsCustomerRecord(resource.data)
        && ownsCustomerRecord(request.resource.data)
        && validRedemptionRequest(request.resource.data)
        && resource.data.status == 'Rejected'
        && request.resource.data.status == 'Pending'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.rewardId == resource.data.rewardId
        && request.resource.data.rewardName == resource.data.rewardName
        && request.resource.data.points == resource.data.points;
      allow update: if isAdmin() && validRedemptionRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /overduePcRequests/{requestId} {
      allow read: if isTeam() || (isCustomer() && ownsCustomerRecord(resource.data) && resource.data.status == 'Approved');
      allow create, update: if isAdmin() && validOverduePcRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bonusPcRequests/{requestId} {
      allow read: if isTeam() || (isCustomer() && ownsCustomerRecord(resource.data) && resource.data.status == 'Approved');
      allow create, update: if isAdmin() && validBonusPcRequest(request.resource.data);
      allow update: if isCustomer()
        && ownsCustomerRecord(resource.data)
        && ownsCustomerRecord(request.resource.data)
        && resource.data.status == 'Approved'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['customerSeenAt'])
        && request.resource.data.customerSeenAt is string
        && request.resource.data.customerSeenAt.size() <= 40;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
